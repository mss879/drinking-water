# Copy to .env.local and fill in. All values are optional in development.

# Public site URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://drinkingwater.lk

# Search engine ownership codes (the content="…" value of each verification meta tag). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# "1" on a staging or test copy: asks search engines not to index it. Netlify deploy previews and branch deploys do this anyway.
NEXT_PUBLIC_NOINDEX=

# Where leads are sent. Every form submission is POSTed here as JSON
# (HubSpot / Zapier / Make / your CRM). With Supabase set up, leads are saved as inquiries in the admin first and
# then also sent here. Without either, leads are logged on the server.
LEAD_WEBHOOK_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Enables analytics and
# conversion tracking for product views, quote requests and rental enquiries.
NEXT_PUBLIC_GTM_ID=

# Supabase: the admin (/admin), inquiries, CRM, website analytics and the blog. See supabase/README.md.
# Project Settings → API Keys. The legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=

# Optional: "1" records visits from localhost and *.test while developing (off by default).
NEXT_PUBLIC_ANALYTICS_DEV=
