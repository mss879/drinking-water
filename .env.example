# Copy to .env.local and fill in. All values are optional in development.

# Public site URL, used for canonical links, sitemap, share cards and structured data. Leave it as the live domain
# (or unset, which means the same).
NEXT_PUBLIC_SITE_URL=https://drinkingwater.lk

# Search engine ownership codes (the content="…" value of each verification meta tag). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# "1" on a staging or test copy: asks search engines not to index it. Netlify deploy previews and branch deploys do this anyway.
NEXT_PUBLIC_NOINDEX=

# Where leads are sent. Every form submission is POSTed here as JSON
# (HubSpot / Zapier / Make / your CRM). With Supabase set up, leads are saved as inquiries in the admin first and
# then also sent here. Without either, leads are logged on the server.
LEAD_WEBHOOK_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Enables analytics and
# conversion tracking for product views, quote requests and rental enquiries.
NEXT_PUBLIC_GTM_ID=

# Supabase: the admin (/admin), inquiries, CRM, website analytics and the blog. See supabase/README.md.
# Project Settings → API Keys. The legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=

# Optional: "1" records visits from localhost and *.test while developing (off by default).
NEXT_PUBLIC_ANALYTICS_DEV=

# The website's chat assistant (docs/ai-chat-agent.md). Server only: never prefix these with NEXT_PUBLIC_.
# Without OPENAI_API_KEY the chat button stays hidden (unless the assistant is switched off in the admin for live chat).
OPENAI_API_KEY=
# Optional: the OpenAI model (default gpt-4o-mini).
OPENAI_MODEL=
# Optional: emails through Resend: chat quotes to visitors, and alerts to the team for chat leads and form inquiries.
# The from address must be on a domain verified in Resend (default "LUSAKO <noreply@drinkingwater.lk>").
RESEND_API_KEY=
CHAT_EMAIL_FROM=
# Optional: how long the model may take for one reply, in ms (default 25000; Netlify gives a function 60 seconds).
CHAT_AI_TIMEOUT_MS=
# Optional: the most assistant replies a day across the site (default 3000), a cap on the OpenAI bill.
CHAT_DAILY_LIMIT=
